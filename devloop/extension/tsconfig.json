{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"]
  },
  "include": [
    "lib/contracts.ts",
    "lib/shell.ts",
    "lib/lock.ts",
    "lib/errors.ts",
    "lib/cancellation.ts",
    "lib/routing.ts",
    "lib/worktree.ts",
    "lib/task.ts",
    "lib/prompts.ts",
    "lib/gates.ts",
    "lib/controller.ts",
    "lib/config.ts",
    "lib/cli.ts",
    "lib/scheduler.ts",
    "lib/pipeline.ts",
    "lib/retro.ts",
    "lib/panel.ts",
    "lib/cards.ts",
    "lib/observer.ts"
  ]
}
